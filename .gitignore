# Unity — 편집기/IDE가 자동 생성하는 로컬 산출물
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/MemoryCaptures/
unity/Screenshots/
unity/Recordings/
unity/CrashReports/
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/*.userprefs

# ML-Agents 프로파일러가 실행마다 생성하는 타이머
unity/Assets/ML-Agents/Timers/

# 크래시 후 Unity가 복구해놓는 미저장 씬 사본
unity/Assets/_Recovery/

# 소스 Assets의 *.meta는 Unity GUID/참조 정보이므로 의도적으로 무시하지 않는다.
# 위 ML-Agents 타이머처럼 폴더 전체가 생성물인 경우만 예외다.

# Python
venv/
.venv/
vision/.vision/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 로컬 환경변수·비밀값 (공유 가능한 예제 파일만 허용)
.env
.env.*
!.env.example

# 런타임 로그·산출물 (스크립트가 실행마다 생성)
vision/**/*.csv
vision/**/vision_dg5f_*.csv
vision/**/calib_log_*.csv
*.log
*.pid

# ZED 3D 비전(YOLO 커스텀 학습) — 촬영 이미지/학습 산출물/사전학습 가중치는 제외
vision/zed_object_detection/dataset/
vision/zed_object_detection/runs/
vision/zed_object_detection/*.pt
# 파인튜닝된 커스텀 타겟 모델은 예외로 보존
!vision/zed_object_detection/weights/dg5f_target_objects_yolov8s.pt

# ML-Agents training/build outputs
training/results/
training/builds/
training/archives/*.tar.gz
training/logs/*.png
training/logs/*.gif
training/logs/recovered/
/DG5FStableGrasp-*.tar.xz
# 학습 중 생성되는 정책은 제외하되, 현재 Grasp 환경의 배포 모델은 소스와 함께 보존한다.
unity/Assets/MLAgents/Grasp/Models/*.onnx
!unity/Assets/MLAgents/Grasp/Models/DG5FGrasp.onnx
unity/Assets/MLAgents/GraspLift/Models/*.onnx
!unity/Assets/MLAgents/GraspLift/Models/DG5FGraspLift.onnx

# 로컬 배포 압축본·편집기 백업
/*.tar.gz
/*.tgz
/*.zip
*.backup
*.bak
*~

# 네이티브 crash dump
core
core.*

# OS
Thumbs.db
.DS_Store

# Agents
*.omc
*.omx
*.claude

# 임시 이식성 검증용 venv (스크립트가 만들었다 지우는 일회성 폴더)
.tmp_*/

# PlayMode 테스트 러너가 Play 진입 때 Assets/에 만드는 임시 씬.
# 정상 종료 시 스스로 지우지만 배치모드가 중단되면 남는다 — 커밋되면 안 된다.
unity/Assets/InitTestScene*.unity
unity/Assets/InitTestScene*.unity.meta

# MuJoCo 런타임 로그 — MuJoCo는 폐기됐지만(CLAUDE.md) 과거 산출물 실행 시 생성된다
MUJOCO_LOG.TXT
unity/MUJOCO_LOG.TXT

# pytest 캐시
.pytest_cache/

# 저장소 루트 Logs/ — Unity 에디터 로그와 브리지 산출물(--track CSV 등)이 섞여 쌓이는 곳.
# 실행할 때마다 달라지는 실측 기록이라 추적하지 않는다.
/Logs/

# SuperDex PoC 산출물 — 전부 재생성 가능하므로 추적하지 않는다.
# 재현: superdex/scripts/train_ppo.py -> export_onnx.py -> (Unity 검증 시 Assets/Policies로 복사)
# 절차는 docs/SUPERDEX_POC_PLAN.md "게이트 1 재현" 참고.
superdex/results/
superdex/policies/
unity/Assets/Policies/
unity/Assets/Policies.meta

# SuperDex asset 루트 마커 — 공식 클론(project_superdex) 위치를 담아 머신마다 다르다.
# superdex/scripts/gate3_setup_asset_root.py 가 config/rtauto_config.py 에서 생성한다
# (원칙 1: 경로 리터럴을 커밋하지 않는다 / 원칙 2: 새 머신은 그 스크립트를 한 번 돌린다).
# 같은 폴더의 arms/·arm_hand_combos/ 는 머신 의존 값이 없으므로 커밋 대상이다.
superdex/assets/bots/.superdex_root
