# This file contains the shared defaults. Copy it to .env to override them locally:
#   cp .env.example .env
#
# Relative paths are resolved from the repository root.
# Priority: process environment > .env > .env.example.

# Grasp headless-compatible Linux player
DG5F_GRASP_BUILD_OUTPUT=training/builds/DG5FGrasp
DG5F_GRASP_PLAYER_NAME=DG5FGrasp.x86_64

# Grasp + Lift Linux player (DG5FGraspLift behavior)
DG5F_GRASPLIFT_BUILD_OUTPUT=training/builds/DG5FGraspLift
DG5F_GRASPLIFT_PLAYER_NAME=DG5FGraspLift.x86_64

# Pick + Place Linux player (DG5FPicknPlace behavior, UR16e + DG5F right hand,
# FOUP-shaped target)
DG5F_PICKNPLACE_BUILD_OUTPUT=training/builds/DG5FPicknPlace
DG5F_PICKNPLACE_PLAYER_NAME=DG5FPicknPlace.x86_64

# Pick + Place Windows player — 같은 behavior의 StandaloneWindows64 빌드.
# 남아있는 학습 머신이 로컬 Windows 워크스테이션 하나뿐이라
# (training/archives/scripts/README.md 참고) headless 학습은 이 플레이어를 쓴다.
# Editor에 붙는 방식은 구조상 환경이 항상 1개라 --num-envs 병렬이 불가능하다.
DG5F_PICKNPLACE_WINDOWS_BUILD_OUTPUT=training/builds/DG5FPicknPlaceWindows
DG5F_PICKNPLACE_WINDOWS_PLAYER_NAME=DG5FPicknPlace.exe

# 학습 씬에 구워지는 병렬 영역 수 ("Tools > ML-Agents > Build DG5F PicknPlace
# Training Scene"이 읽는다). 총 에이전트 = 이 값 x RTAUTO_TRAIN_NUM_ENVS이므로
# 둘을 같이 튜닝한다. 기본 40.
# DG5F_PICKNPLACE_TRAINING_AREAS=40

# mlagents-learn이 동시에 띄우는 플레이어 프로세스 수
# (training/scripts/train_picknplace.py --num-envs 기본값). 플레이어 1개당 대략
# CPU 코어 1개 + RAM 0.4 GB. 물리코어보다 많이 띄우면 트레이너와 다퉈 오히려 느려진다 —
# 머신마다 측정해서 정할 것(측정법은 training/README.md).
# RTAUTO_TRAIN_NUM_ENVS=1

# Grasp-ready Reach Linux player
DG5F_REACH_BUILD_OUTPUT=training/builds/DG5FGraspReadyReach
DG5F_REACH_PLAYER_NAME=DG5FGraspReadyReach.x86_64

# Vendored Linux libdl.so.2 copied next to the built player as libdl.so for the
# URDF importer probe. Lets the Linux players build from Windows/macOS hosts that
# do not ship a glibc libdl. On a Linux build host the system library is used as
# a fallback automatically.
DG5F_LINUX_LIBDL_SOURCE=build-support/linux/libdl.so.2

# --- 아래는 config/rtauto_config.py(Python vision/tools 스크립트)가 읽는 값 ---
# 같은 파일, 같은 .env 하나로 Unity 빌드 설정과 Python 런타임 설정을 함께 관리한다.

# 네트워크: Unity가 이 PC(로컬)에서 돈다면 기본값(127.0.0.1)을 안 건드려도 됨
# RTAUTO_UNITY_IP=127.0.0.1
# RTAUTO_PORT_DG5F_SIM=5006
# RTAUTO_PORT_ZED_TARGET=5007
# RTAUTO_PORT_DG5F_BRIDGE=5008
# RTAUTO_PORT_UR_ARM_BRIDGE=5009  # Unity UrArmSender -> arm/ur_rtde_bridge.py
# RTAUTO_PORT_UR_ARM_SIM=5010     # arm/ur_rtde_bridge.py --echo-to-unity -> Unity UrArmReceiver
# RTAUTO_PORT_MLAGENTS_BASE=5100   # mlagents-learn <-> Unity player gRPC (BASE..BASE+num_envs-1)

# Unity(Dg5fSender.cs) → dg5f_sdk_bridge.py 방향의 대상 IP. 둘이 같은 PC면 기본값 그대로.
# RTAUTO_DG5F_BRIDGE_IP=127.0.0.1

# Unity(UrArmSender.cs) → arm/ur_rtde_bridge.py 방향의 대상 IP. 둘이 같은 PC면 기본값 그대로.
# 🛑 아래 RTAUTO_UR_IP(브리지 → URSim/실물 컨트롤박스)와 다른 값이다 — 실물 전환 때
# RTAUTO_UR_IP만 컨트롤박스 IP로 바꾸고 이 값은 그대로 둔다(둘 다 로컬이면 그대로 둬도 됨).
# RTAUTO_UR_ARM_BRIDGE_IP=127.0.0.1

# 실물 DG-5F 그리퍼 자신의 IP. 세 브리지(dg5f_sdk_bridge / dg5f_readback_bridge /
# dg5f_modbus_readback)가 `--ip`를 **값 없이** 줬을 때 여기서 읽는다 — 그래서 명령줄과
# 문서에 IP 리터럴을 적지 않아도 된다. `--ip`를 아예 생략하면 드라이런(실물 미접속)이다.
# 그리퍼는 보통 링크로컬(169.254.x.x)이라 그리퍼용 이더넷에 꽂혀 있을 때만 도달 가능하다.
# 기본값 없음 — 안 채우고 `--ip`만 주면 명확한 에러로 멈춘다.
# RTAUTO_DG5F_IP=169.254.x.x

# DG5F 손 관절 각속도 상한[deg/s]. 실물 브리지(슬루 리밋)와 Unity 주먹쥐기 버튼이 함께 읽어
# 트윈과 실물이 같은 속도로 움직이게 한다. 실물이 튀지 않으면 올려도 된다(무부하 한계 450).
# RTAUTO_DG5F_MAX_DEG_PER_SEC=100

# 실물에서 캡처한 파지 자세 파일(Unity "파지하기" 버튼이 읽는다). 대상 물체가 바뀌면
# dg5f_readback_bridge.py --capture-pose 로 다시 떠서 덮어쓰거나, 다른 경로를 지정한다.
# RTAUTO_DG5F_GRASP_POSE=config/dg5f_grasp_pose.json

# ---------------- 손목 카메라가 팔 끝에 어떻게 붙었나 (D-6) ----------------
# 🛑 이 값이 없으면 카메라가 와도 "본 것" 을 로봇 좌표로 못 옮긴다.
# 기본값 0 은 **"아직 안 쟀다"** 는 뜻이다. 0인 채로도 배관은 돌지만 결과를 믿으면 안 된다.
# 확인: python arm/eye_in_hand.py --check
# RTAUTO_D405_MOUNT_PARENT=tool0
# RTAUTO_D405_MOUNT_XYZ_M=0,0,0
# RTAUTO_D405_MOUNT_RPY_DEG=0,0,0
#
# 🛑 위 값을 채웠다고 실물 자동 이동이 열리지 않는다. "값이 들어있다"와 "실물로
# 검증했다"는 다르다 — 실물 자동 이동은 아래 값이 1이어야만 열린다(P1-5).
# 기본값은 반드시 0이다. hand-eye 검증(BACKLOG Q2/Q3)을 사람이 실제로 끝낸 뒤에만
# **사람이 직접** 1로 바꿀 것 — 프로그램이 스스로 바꾸게 하지 않는다.
# RTAUTO_D405_MOUNT_VALIDATED=0
# 카메라 내부 값(초점거리·중심). 0 이면 시야각에서 계산해 쓴다.
# 실물에서는 RealSense SDK 가 알려 주는 값을 넣는다 — 개체마다 다르다.
# 잰 법: python vision/d405/probe_d405.py --info --env  → 나온 줄을 그대로 .env 에 붙인다.
# 🛑 .env 는 git 이 추적하지 않는다. **다른 PC 로 옮기면 이 값이 따라오지 않는다** —
#    새 PC 에서는 위 명령을 한 번 돌려야 한다 (docs/PYTHON_ENV_SETUP.md §3-1).
# ⚠️ 실측값은 **잰 해상도에서만** 맞는다. 잰 해상도를 같이 적으면 다른 크기로
#    물어볼 때 그 비율만큼 자동 환산된다 — 안 그러면 2배 틀린 값이 조용히 나간다.
# RTAUTO_D405_CALIB_WIDTH=1280
# RTAUTO_D405_CALIB_HEIGHT=720
# RTAUTO_D405_FX=0
# RTAUTO_D405_FY=0
# RTAUTO_D405_CX=0
# RTAUTO_D405_CY=0

# ---------------- "좋은 자세" 를 고르는 기준 ----------------
# 잡은 뒤 물체가 손 안에서 돌아간 각도(도)가 이 값 이하여야 고를 만한 자세로 본다.
# ⚠️ 성공/실패 판정과는 무관하다 — 성공한 자세들 중 어느 것을 고를지에만 쓴다.
# 실측(2026-09-18, 물체 9종): 5도 -> 42칸 / 8도 -> 63칸 / 10도 -> 85칸.
# 학습이 표본 부족으로 안 되면 여기부터 8~10 으로 올린다.
# RTAUTO_GRASP_GOOD_TILT_DEG=5.0

# ---------------- DG5F 접촉 감지 (손끝 센서가 없어서 대신 쓰는 것) ----------------
# 설계·근거: docs/GRASP_CONTACT_DETECTION.md
# ⚠️ 아래 숫자는 전부 **실측 전 잠정값**이다. 먼저 hand/measure_baseline.py 로 무부하
#    전류를 재고(그 결과가 RTAUTO_DG5F_BASELINE 파일), 그다음 이 값들을 맞춘다.
# RTAUTO_DG5F_BASELINE=config/dg5f_current_baseline.json
# RTAUTO_DG5F_CONTACT_CURRENT_SIGMA=6
# RTAUTO_DG5F_CONTACT_CURRENT_FLOOR_MA=80
# RTAUTO_DG5F_CONTACT_POS_ERR_DEG=2.0
# RTAUTO_DG5F_CONTACT_VEL_RPM=3.0
# RTAUTO_DG5F_CONTACT_HOLD_TICKS=8
# RTAUTO_DG5F_CONTACT_MIN_FINGERS=3
# RTAUTO_DG5F_CLOSE_TIMEOUT_S=3.0
# RTAUTO_DG5F_CURRENT_LIMIT_MA=800
# RTAUTO_DG5F_TEMP_LIMIT_C=65
# RTAUTO_DG5F_FRAME_TIMEOUT_S=0.5

# ---------------- 잡았는지 확인하기 (들어올린 뒤) ----------------
# RTAUTO_GRASP_LIFT_HEIGHT_M=0.05
# RTAUTO_GRASP_LIFT_SPEED_MPS=0.02

# 접근 시작 지점(pre-approach)에서 최종 파지 직전 자세까지 마지막 직선 구간의
# 속도(m/s) — ArmMover.move_to()의 moveL 구간(P1-4). 물체에 가까워지는 구간이라
# 느리게 잡는다.
# RTAUTO_APPROACH_SPEED_MPS=0.05

# move_to()가 명령을 다 보낸 뒤 "정말 도착했나"를 판정하는 허용 오차(관절마다, deg).
# 실측 전 잠정값 — 실물에서 재조정할 것.
# RTAUTO_ARRIVAL_TOLERANCE_DEG=1.0
# RTAUTO_GRASP_PROBE_DEG=5.0
# RTAUTO_GRASP_SLIP_CLOSE_DEG=3.0
# RTAUTO_GRASP_SLIP_CURRENT_RATIO=0.5
# RTAUTO_GRASP_FT_MIN_DELTA_N=3.0

# MediaPipe 웹캠.
# INDEX: 기본값 ask = 실행할 때 **선택 창**을 띄워 물어본다(카메라가 한 대면 안 묻는다).
#   숫자를 적으면 그 번호로 고정(가장 빠름), auto면 묻지 않고 가장 좋은 것을 알아서 고른다.
#   시작 시간 실측(카메라 1대): 번호 고정 3.2초 / ask 4.5초 / auto 4.5초.
#   노트북에 외장 웹캠을 꽂으면 카메라가 두 대가 되는데 어느 쪽이 0번인지는 OS가 정하고
#   재부팅·USB 포트 변경으로 뒤바뀐다. 어느 번호가 어느 카메라인지 보려면:
#       python vision/dg5f/camera_caps.py --list
#   (Linux에서는 `ls /dev/video*`의 번호가 곧 INDEX다.)
# BACKEND: auto(권장). auto로 카메라가 안 열릴 때만 OS에 맞는 값으로 바꾼다 —
#   Windows: msmf | dshow    Linux: v4l2 | gstreamer    macOS: avfoundation
# WIDTH/HEIGHT: 기본값 max = "이 웹캠에서 쓸 수 있는 가장 좋은 화면". 처음 한 번만 실제로
#   크기와 속도를 재서 고르고(수십 초) 그 값을 vision/dg5f/camera_caps_cache.json에 적어
#   둔다 — 다음 실행부터는 바로 그 크기로 연다. 숫자를 적으면 그 크기로 고정(탐색 안 함).
#   확인 방법: python vision/dg5f/camera_caps.py 0   (--refresh를 붙이면 다시 탐색)
# MIN_FPS: "쓸 만하다"의 기준선. 큰 화면이 항상 좋은 게 아니라서 필요하다 — 실측으로 같은
#   웹캠이 2592x1944에서 초당 1장, 1920x1080에서 초당 30장이었다. 기준보다 느린 크기는
#   더 크더라도 버린다. 30장을 원하면 25 정도로 올린다.
# FOURCC: 비워 두면 기본 포맷과 MJPG를 실측 비교해 더 좋은 쪽을 자동 선택한다. 특정 포맷만
#   써야 하는 장비에서는 MJPG 같은 네 글자 값을 명시한다.
# RTAUTO_VISION_CAMERA_INDEX=0        # 또는 auto / ask
# RTAUTO_VISION_CAMERA_WIDTH=max
# RTAUTO_VISION_CAMERA_HEIGHT=max
# RTAUTO_VISION_CAMERA_FPS=30
# RTAUTO_VISION_CAMERA_MIN_FPS=15
# RTAUTO_VISION_CAMERA_BACKEND=auto
# RTAUTO_VISION_CAMERA_FOURCC=
# RTAUTO_VISION_PREVIEW_WIDTH=1280

# 다중 웹캠(vision/dg5f/multi_camera_capture.py — 디지털 트윈 다시점 모니터링 등)용
# 인덱스 목록, 쉼표구분. 비우면 위 RTAUTO_VISION_CAMERA_INDEX 하나만 쓴다.
# RTAUTO_VISION_CAMERA_INDICES=0,1,2

# 다중 웹캠 3D 캘리브레이션(calibrate_intrinsics.py/calibrate_extrinsics.py) — 실제 보유한
# 체스보드의 내부 코너 개수·한 칸 실측 변(mm)으로 바꿀 것. 기본값은 9x6/25mm 예시 보드.
# RTAUTO_CALIB_BOARD_COLS=9
# RTAUTO_CALIB_BOARD_ROWS=6
# RTAUTO_CALIB_SQUARE_SIZE_MM=25.0
# RTAUTO_CALIB_DIR=vision/dg5f/camera_calib

# tools/urdf_hand_import (URDF→Unity 임포트 파이프라인) — 머신마다 다르므로 기본값 없음.
# 비워두면 --project/--cli 를 직접 넘겨야 한다.
# RTAUTO_UNITY_PROJECT=D:/UnityProjects/cli_test/KDT_robot_AI
# RTAUTO_UNITY_CLI=C:/Users/<you>/AppData/Local/unity-cli/unity-cli.exe

# DG-5F 실물 SDK — 비워두면 vision/dg5f/dg5f_sdk_bridge.py가 스크립트 기준 상대경로 기본값을 사용
# RTAUTO_DG5F_DLL=D:/path/to/태슬로sdk/DGSDKSample_ver_2_0_1/DGSDK/DGSDK.dll

# 공식 벤더 파이썬 SDK(dgsdk, vision/dg5f/dg5f_sdk_bridge_dgsdk.py — 미검증/드라이런 전용)의
# DGSDK.dll/libDGSDK.so 디렉터리. 비워두면 저장소에 vendor로 커밋된
# vision/dg5f/vendor/dgsdk-python/libs를 쓴다 — 보통 비워둘 것.
# RTAUTO_DG5F_DGSDK_LIB_DIR=D:/path/to/other/dgsdk/libs

# vision/dg5f/analyze_teleop.py·analyze_thumbik.py — 머신마다 다르므로 기본값 없음.
# 비워두면 --logs-dir/--urdf-dir 를 직접 넘겨야 한다.
# DG5F_UNITY_LOGS=D:/UnityProjects/cli_test/KDT_robot_AI/Logs
# DG5F_URDF_DIR=D:/src/tesollo_model/dg5f

# urdf/build_arm_hand.py — UR 팔+DG5F 손 결합 URDF 빌드.
# Universal_Robots_ROS2_Description 공개 레포를 체크아웃한 폴더(urdf/·meshes/가 바로 안에 있음).
# 저장소에 포함하지 않는 외부 의존이라 기본값이 없다 — 비우면 --ur-description을 직접 넘겨야 한다.
# RTAUTO_UR_DESCRIPTION=D:/src/Universal_Robots_ROS2_Description

# 팔+손 결합 URDF. 손 관절 20개 순서의 정본이며 저장소 안에 기본값이 있다.
# 다른 손(왼손 등)으로 바꿔 실험할 때만 채운다.
# RTAUTO_ARM_HAND_URDF=D:/workspace/KDT_1_AX_rtauto/urdf/ur16e_dg5f_right_build/ur16e_dg5f_right.urdf

# 로봇 구성 (하드웨어 스펙 2026-08-25 확정: UR16e + DG-5F-M-R 오른손).
# 스펙 변동 가능성이 통보돼 있어 코드가 아니라 여기서 바꾼다.
# RTAUTO_UR_TYPE=ur16e
# RTAUTO_DG5F_HAND=right
# RTAUTO_DG5F_SHORT=0

# UR16e RTDE (arm/ur_rtde_bridge.py). URSim을 도커로 로컬 실행하면(docs/SIM2REAL_ROADMAP.md
# §9) 포트가 호스트로 매핑돼 127.0.0.1로 도달하므로 기본값 그대로 둬도 된다.
# 실물로 전환할 때만 실제 컨트롤박스 IP로 바꾼다.
# RTAUTO_UR_IP=127.0.0.1
# RTAUTO_UR_MAX_DEG_PER_SEC=30

# 카메라가 찍은 시각부터 팔이 실제로 그 자세로 움직이기 시작할 때까지 허용하는 최대
# 경과 시간[초]. 넘으면 arm/prepose_to_joints.py가 움직이지 않고 거절한다(P4).
# RTAUTO_MAX_POSE_AGE_SEC=10.0

# 공용 venv 파이썬 — Unity "UR16e 팔" 패널의 "브리지 실행" 버튼이 이걸로
# arm/ur_rtde_bridge.py를 띄운다. 비워두면 OS별 기본값
# (Windows: vision/.vision/Scripts/python.exe, Linux/macOS: vision/.vision/bin/python).
# RTAUTO_PYTHON=vision/.vision/Scripts/python.exe

# ---------------- SuperDex PoC (브랜치 SuperDexTest, 2026-09-07 신설) ----------------
# 평가 계획·게이트·회귀 기준은 docs/SUPERDEX_POC_PLAN.md 가 정본이다.
# SuperDex는 Python 3.12 전용이라 기존 3.10.11 venv(vision/.vision)와 섞지 않는다.

# project_superdex 클론 루트. asset 트리(assets/)가 wheel에 없고 저장소 안에만 있어서
# 클론이 필수다. 외부 공개 레포라 머신마다 위치가 달라 기본값이 없다 —
# 비우면 superdex_assets_path()가 None을 돌려주고 각 스크립트가 명확히 에러난다.
# RTAUTO_SUPERDEX_REPO=D:/src/project_superdex

# asset 트리를 클론 밖에 따로 두는 경우에만 지정. 비우면 <repo>/assets 로 파생된다.
# 런처가 이 값을 SuperDex가 읽는 이름(SUPERDEX_ASSETS_PATH)으로 내보낸다.
# RTAUTO_SUPERDEX_ASSETS=D:/src/project_superdex/assets

# SuperDex 전용 3.12 venv 파이썬. 비우면 OS별 기본값
# (Windows: superdex/.venv/Scripts/python.exe, Linux/macOS: superdex/.venv/bin/python).
# RTAUTO_SUPERDEX_PYTHON=superdex/.venv/Scripts/python.exe

# 물리 스텝 주기(Hz). 동봉 예제 실측값 200 = 1/200 s. 접촉 품질에 직결되는 값이다.
# RTAUTO_SUPERDEX_SIM_HZ=200

# Ray env runner 수와 learner GPU 수. runner 기본값은 os.cpu_count()에서 파생된다
# (스레드-4: 회사 6C/12T -> 8, 집 8C/16T -> 12, 개인 노트북 14C/14T -> 10) — 머신 사양을
# 코드나 .env에 박지 않기 위한 것이므로 실측 후 더 좋은 값을 찾았을 때만 아래를 켠다.
# SuperDex 기본값은 runner 32 / GPU 0인데 32는 세 머신 모두 스레드 수를 넘는다.
# ⚠️ 회사 RTX 2080은 Turing이라 bf16 미지원 — docs/SUPERDEX_POC_PLAN.md §8.
# RTAUTO_SUPERDEX_ENV_RUNNERS=8
#
# 🛑 **CUDA GPU가 없는 머신은 GPUS_PER_LEARNER 를 0 으로 내려야 한다.** 코드 기본값이 1
#    이라 그대로 두면 Ray 가 잡을 GPU 를 못 찾는다. 개인 노트북(Intel Arc 내장, CUDA 없음)이
#    이 경우이고 실제로 0 을 쓴다. 회사/집(RTX)은 1 이 맞으므로 이 줄을 켜지 않는다.
#    확인: python -c "import torch; print(torch.cuda.is_available())"
# RTAUTO_SUPERDEX_GPUS_PER_LEARNER=1
#
# RAM 이 16 GB 인 머신(개인 노트북)은 runner 를 스레드 수에서 파생한 값(10)으로 돌리면
# 메모리가 먼저 막힐 수 있다. OOM 이 나면 코드 기본값이 아니라 위 ENV_RUNNERS 를 낮춘다.

# 학습·ONNX 정책 산출물 폴더. 저장소 상대 기본값(superdex/results, superdex/policies)이
# 있으므로 다른 디스크로 뺄 때만 절대경로로 덮어쓴다.
# RTAUTO_SUPERDEX_RESULTS_DIR=superdex/results
# RTAUTO_SUPERDEX_POLICY_DIR=superdex/policies

# ---------------- 물체 앞까지 자율 접근 (pre-grasp) ----------------
# 카메라가 본 물체 앞 "파지 직전 위치"까지 팔이 스스로 가는 경로의 값들.
# 전부 잠정값이다 — 실물에서 재 보고 고친다. 자세한 설명은 config/rtauto_config.py.
# RTAUTO_PREGRASP_DISTANCE_M=0.12
# RTAUTO_APPROACH_CLEARANCE_M=0.05
# RTAUTO_DG5F_GRASP_CENTER_PALM_M=0.0356,0.0007,0.0426
# RTAUTO_DG5F_GRASP_RADIUS_M=0.0447
# 안전 한계 — 이 밖으로 나가는 목표는 만들지 않는다
# RTAUTO_WORKSPACE_MIN_M=-0.75,-0.75,-0.10
# RTAUTO_WORKSPACE_MAX_M=0.75,0.75,0.90
# RTAUTO_WORKSPACE_MAX_RADIUS_M=0.85
# RTAUTO_WORKSPACE_MIN_RADIUS_M=0.25
# RTAUTO_MAX_STEP_M=0.40
# 아까 고른 물체가 보이는 동안, 다른 물체가 이만큼(m) 더 가까워야 대상을 바꾼다
# RTAUTO_TARGET_SWITCH_MARGIN_M=0.03
# 아까 고른 물체가 안 보여도 이 장면 수까지는 갈아타지 않고 기다린다(인식 깜빡임 대비)
# RTAUTO_TARGET_HOLD_MISSING_FRAMES=3
# RTAUTO_MIN_DETECT_CONFIDENCE=0.40
# RTAUTO_MIN_OBJECT_POINTS=60
# RTAUTO_OBJECT_MIN_SIZE_M=0.02
# RTAUTO_OBJECT_MAX_SIZE_M=0.16
# RTAUTO_OBJECT_STANDING_MAX_TILT_DEG=30
# RTAUTO_OBJECT_LYING_MAX_TILT_DEG=60
# RTAUTO_OBJECT_AXIS_RATIO_MIN=1.25
# 어느 주소가 가짜 팔(URSim)인가 — 장착값을 아직 안 쟀을 때 여기 있는 주소에서만
# --unvalidated-mount-ok 로 움직일 수 있다. 실물 컨트롤박스 IP를 절대 넣지 말 것.
# RTAUTO_UR_SIM_IPS=127.0.0.1,localhost
