# This file contains the shared defaults. Copy it to .env to override them locally:
#   cp .env.example .env
#
# Relative paths are resolved from the repository root.
# Priority: process environment > .env > .env.example.

# Grasp headless-compatible Linux player
DG5F_GRASP_BUILD_OUTPUT=training/builds/DG5FGrasp
DG5F_GRASP_PLAYER_NAME=DG5FGrasp.x86_64

# Grasp + Lift Linux player (DG5FGraspLift behavior)
DG5F_GRASPLIFT_BUILD_OUTPUT=training/builds/DG5FGraspLift
DG5F_GRASPLIFT_PLAYER_NAME=DG5FGraspLift.x86_64

# Pick + Place Linux player (DG5FPicknPlace behavior, UR16e + DG5F right hand,
# FOUP-shaped target)
DG5F_PICKNPLACE_BUILD_OUTPUT=training/builds/DG5FPicknPlace
DG5F_PICKNPLACE_PLAYER_NAME=DG5FPicknPlace.x86_64

# Grasp-ready Reach Linux player
DG5F_REACH_BUILD_OUTPUT=training/builds/DG5FGraspReadyReach
DG5F_REACH_PLAYER_NAME=DG5FGraspReadyReach.x86_64

# Vendored Linux libdl.so.2 copied next to the built player as libdl.so for the
# URDF importer probe. Lets the Linux players build from Windows/macOS hosts that
# do not ship a glibc libdl. On a Linux build host the system library is used as
# a fallback automatically.
DG5F_LINUX_LIBDL_SOURCE=build-support/linux/libdl.so.2

# --- 아래는 config/rtauto_config.py(Python vision/tools 스크립트)가 읽는 값 ---
# 같은 파일, 같은 .env 하나로 Unity 빌드 설정과 Python 런타임 설정을 함께 관리한다.

# 네트워크: Unity가 이 PC(로컬)에서 돈다면 기본값(127.0.0.1)을 안 건드려도 됨
# RTAUTO_UNITY_IP=127.0.0.1
# RTAUTO_PORT_DG5F_SIM=5006
# RTAUTO_PORT_ZED_TARGET=5007
# RTAUTO_PORT_DG5F_BRIDGE=5008

# MediaPipe 웹캠. 여러 카메라가 있으면 INDEX를 0, 1, 2 순서로 바꿔 확인한다.
# (Linux에서는 `ls /dev/video*`의 번호가 곧 INDEX다.)
# BACKEND: auto(권장). auto로 카메라가 안 열릴 때만 OS에 맞는 값으로 바꾼다 —
#   Windows: msmf | dshow    Linux: v4l2 | gstreamer    macOS: avfoundation
# RTAUTO_VISION_CAMERA_INDEX=0
# RTAUTO_VISION_CAMERA_WIDTH=1280
# RTAUTO_VISION_CAMERA_HEIGHT=720
# RTAUTO_VISION_CAMERA_FPS=30
# RTAUTO_VISION_CAMERA_BACKEND=auto

# tools/urdf_hand_import (URDF→Unity 임포트 파이프라인) — 머신마다 다르므로 기본값 없음.
# 비워두면 --project/--cli 를 직접 넘겨야 한다.
# RTAUTO_UNITY_PROJECT=D:/UnityProjects/cli_test/KDT_robot_AI
# RTAUTO_UNITY_CLI=C:/Users/<you>/AppData/Local/unity-cli/unity-cli.exe

# DG-5F 실물 SDK — 비워두면 vision/dg5f/dg5f_sdk_bridge.py가 스크립트 기준 상대경로 기본값을 사용
# RTAUTO_DG5F_DLL=D:/path/to/태슬로sdk/DGSDKSample_ver_2_0_1/DGSDK/DGSDK.dll

# vision/dg5f/analyze_teleop.py·analyze_thumbik.py — 머신마다 다르므로 기본값 없음.
# 비워두면 --logs-dir/--urdf-dir 를 직접 넘겨야 한다.
# DG5F_UNITY_LOGS=D:/UnityProjects/cli_test/KDT_robot_AI/Logs
# DG5F_URDF_DIR=D:/src/tesollo_model/dg5f

# urdf/build_arm_hand.py — UR 팔+DG5F 손 결합 URDF 빌드.
# Universal_Robots_ROS2_Description 공개 레포를 체크아웃한 폴더(urdf/·meshes/가 바로 안에 있음).
# 저장소에 포함하지 않는 외부 의존이라 기본값이 없다 — 비우면 --ur-description을 직접 넘겨야 한다.
# RTAUTO_UR_DESCRIPTION=D:/src/Universal_Robots_ROS2_Description

# 로봇 구성 (하드웨어 스펙 2026-08-25 확정: UR16e + DG-5F-M-R 오른손).
# 스펙 변동 가능성이 통보돼 있어 코드가 아니라 여기서 바꾼다.
# RTAUTO_UR_TYPE=ur16e
# RTAUTO_DG5F_HAND=right
# RTAUTO_DG5F_SHORT=0
